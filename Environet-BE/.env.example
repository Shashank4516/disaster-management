# Backend
PORT=3000
# Connection used by the app when running outside Docker (Dockerized DB on host port 5432)
DATABASE_URL=postgres://environet:environet@localhost:5432/environet_db
# Set to true to disable the live mock ingestion loop
SIMULATOR_DISABLED=false

# Auth (seeded admin account + JWT signing)
JWT_SECRET=change-me-to-a-long-random-string
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=admin123

# Database service (docker-compose.yml)
POSTGRES_USER=environet
POSTGRES_PASSWORD=environet
POSTGRES_DB=environet_db
